# Token for the MinerU 精准解析 (precise) API.
# Create one on the API management page at https://mineru.net, then copy this
# file into place and fill in the value:
#
#   cp .env.example .env
#
# The real .env is git-ignored. `MINERU_TOKEN` can also be exported as a normal
# environment variable, which takes precedence over this file.
MINERU_TOKEN=your-token-here
